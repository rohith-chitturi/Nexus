# NEXUS Environment Variables - Example Configuration
# DO NOT COMMIT actual credentials to this repository.

# Database
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Agent Config
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
